# --- Database ---
# Local dev: Postgres from docker-compose (`docker compose up -d`).
# Inside compose the api service overrides this to point at `postgres:5432`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/harness_eval

# For tests only (conftest.py already defaults to this):
# DATABASE_URL=sqlite:///:memory:

# --- Ollama (host install for MVP) ---
# From the host / local dev:
OLLAMA_BASE_URL=http://localhost:11434
# From inside docker (compose sets OLLAMA_BASE_URL to this instead):
OLLAMA_HOST_URL=http://host.docker.internal:11434

# --- Event ingestion (F6) ---
# Shared secret for POST /api/events/ingest (X-Ingest-Token header).
# The AI gateway uses this to push llm_request/llm_response/error events.
INGEST_TOKEN=dev-ingest-token

# --- AI gateway (F3) ---
# Host-published port (compose maps 8081->8080; 8080 is taken locally).
GATEWAY_URL=http://localhost:8081
# Where the gateway reaches Ollama. Host-run dev: localhost:11434.
# Inside compose it is set to http://host.docker.internal:11434.
OLLAMA_UPSTREAM_URL=http://localhost:11434
# Where the gateway POSTs metering events (/api/events/ingest).
# Host-run dev: http://localhost:8001 ; inside compose: http://api:8000
API_INGEST_URL=http://localhost:8001
# HMAC secret for run/sandbox bearer creds (heg.<payload>.<sig>).
# The api service uses the SAME secret to mint creds for sandboxes/evaluator.
GATEWAY_CRED_SECRET=dev-secret-change-me
# Per-run token budget enforced before forwarding to the upstream.
DEFAULT_RUN_TOKEN_BUDGET=200000

# --- Artifacts ---
ARTIFACT_ROOT=./data/artifacts

# --- Orchestrator (F2) ---
# Optional: override the rubric-drafting model (default: the run's model).
# RUBRIC_MODEL=qwen2.5-coder:3b
# Compose-managed (usually leave unset): HOST_DATA_ROOT=${PWD}/data is set by
# docker-compose.yml so sandbox bind-mount sources resolve on the host.
# SANDBOX_IMAGE=heg-sandbox:latest
# MONITOR_POLL_SECONDS=5
# EVAL_TIMEOUT_SECONDS=1800
# Token allowance for rubric-draft + per-eval judge creds (added on top of
# tokens already spent, so judges can't 429 on participant spend).
# EVAL_TOKEN_BUDGET=200000

LOG_LEVEL=INFO
