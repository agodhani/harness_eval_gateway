# --- Database ---
# Local dev: Postgres from docker-compose (`docker compose up -d`).
# Inside compose the api service overrides this to point at `postgres:5432`.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/harness_eval

# For tests only (conftest.py already defaults to this):
# DATABASE_URL=sqlite:///:memory:

# --- Ollama (host install for MVP) ---
# From the host / local dev:
OLLAMA_BASE_URL=http://localhost:11434
# From inside docker (compose sets OLLAMA_BASE_URL to this instead):
OLLAMA_HOST_URL=http://host.docker.internal:11434

# --- Event ingestion (F6) ---
# Shared secret for POST /api/events/ingest (X-Ingest-Token header).
# The AI gateway uses this to push llm_request/llm_response/error events.
INGEST_TOKEN=dev-ingest-token

# --- AI gateway (F3) ---
# Host-published port (compose maps 8081->8080; 8080 is taken locally).
GATEWAY_URL=http://localhost:8081
# Where the gateway reaches Ollama. Host-run dev: localhost:11434.
# Inside compose it is set to http://host.docker.internal:11434.
OLLAMA_UPSTREAM_URL=http://localhost:11434
# Where the gateway POSTs metering events (/api/events/ingest).
# Host-run dev: http://localhost:8001 ; inside compose: http://api:8000
API_INGEST_URL=http://localhost:8001
# HMAC secret for run/sandbox bearer creds (heg.<payload>.<sig>).
# The api service uses the SAME secret to mint creds for sandboxes/evaluator.
GATEWAY_CRED_SECRET=dev-secret-change-me
# Per-run token budget enforced before forwarding to the upstream.
DEFAULT_RUN_TOKEN_BUDGET=200000
# Whole-request timeout (seconds) for upstream httpx calls — congested
# local providers queue calls server-side, so keep this comfortably above
# the slowest expected generation; a firing read timeout abandons upstream
# work the client still pays for.
# UPSTREAM_TIMEOUT_SECONDS=300
# Extra attempts on transient upstream failures (timeouts, refused/reset,
# bare 502/503/504) retried inside the gateway; backoff base doubles.
# UPSTREAM_RETRY_ATTEMPTS=2
# UPSTREAM_RETRY_BACKOFF_SECONDS=5
# Miniloop's per model-call timeout (seconds) — must EXCEED
# UPSTREAM_TIMEOUT_SECONDS or the agent abandons calls the gateway is
# still paying for upstream.
# MINILOOP_LLM_TIMEOUT_SECONDS=600
# --- Response cache / deterministic replay (PR18, dev-CI aid) ---
# OFF by default: real runs must hit the live upstream. When enabled,
# metered generation calls (/v1/chat/completions, /v1/messages,
# /v1/responses) replay from a local sqlite store keyed on
# path+provider+request-body — hits skip upstream entirely, still emit
# llm_* events (payload.cached=true, plus an x-heg-cache: hit header) and
# still count toward the run budget, so a replay meters identically.
# GATEWAY_CACHE_ENABLED=false
# sqlite file for cached responses (':memory:' = per-process only). In
# compose the gateway mounts ./data at /data — persist with:
# GATEWAY_CACHE_PATH=./data/gateway_cache.sqlite3
# LRU bound on stored entries.
# GATEWAY_CACHE_MAX_ENTRIES=10000
# Salt in every cache key — bump to invalidate all entries without
# deleting the file (e.g. after changing provider routing/defaults).
# GATEWAY_CACHE_NAMESPACE=v1
# Upstream provider: `ollama` (default, local) or a hosted provider —
# `openrouter`, `openai`, `anthropic`. Process-wide default; sandboxes
# still only see the gateway. Endpoint coverage per provider:
#   ollama:     chat/completions + messages(+count_tokens) + responses + models
#   openrouter: chat/completions + models
#   openai:     chat/completions + responses + models (no /v1/messages —
#               claude_code/dsh can't use it)
#   anthropic:  messages(+count_tokens) + models (no chat/completions —
#               miniloop/rubric drafting can't use it)
# UPSTREAM_PROVIDER=ollama
# Optional per-model routing — JSON object of model globs → provider;
# first match wins (case-insensitive), unmatched models use
# UPSTREAM_PROVIDER. Lets one gateway e.g. serve claude_code via Anthropic
# while everything else stays on Ollama.
# PROVIDER_ROUTES={"claude-*": "anthropic", "gpt-*": "openai"}
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_VERSION=2023-06-01

# --- Artifacts ---
ARTIFACT_ROOT=./data/artifacts

# --- Orchestrator (F2) ---
# Optional: override the rubric-drafting model (default: the run's model).
# RUBRIC_MODEL=qwen2.5-coder:3b
# Compose-managed (usually leave unset): HOST_DATA_ROOT=${PWD}/data is set by
# docker-compose.yml so sandbox bind-mount sources resolve on the host.
# SANDBOX_IMAGE=heg-sandbox:latest
# MONITOR_POLL_SECONDS=5
# EVAL_TIMEOUT_SECONDS=1800
# Token allowance for rubric-draft + per-eval judge creds (added on top of
# tokens already spent, so judges can't 429 on participant spend).
# EVAL_TOKEN_BUDGET=200000
# Per-request output caps (chat-completions max_tokens) for the rubric draft
# and the eval judge. Thinking models burn output tokens on <think> blocks —
# small caps truncate rubric JSON / scores.json into unparseable output.
# RUBRIC_MAX_TOKENS=8192
# EVAL_JUDGE_MAX_TOKENS=8192
# Extra rubric-draft attempts beyond the first on transient upstream errors
# (429/5xx/timeouts) and parse/validation failures (error fed back into the
# prompt). 0 = single attempt.
# RUBRIC_GEN_RETRIES=2

# --- Run pacing (PR15) ---
# Runs serialize: approvals while a run executes park in status="queued"
# and promote FIFO when the slot frees (no config — the state machine).
# Spawn memory gate: wait for this much free host/VM memory (MiB) before
# each `docker run`; 0 disables.
# SPAWN_MIN_FREE_MEM_MB=2048
# SPAWN_MEM_POLL_SECONDS=5
# Cap on the wait — expiry fails that one sandbox (remaining configs then
# fail fast, one probe each) so pressure can't hang a run for N×cap.
# SPAWN_MEM_WAIT_SECONDS=3600

# --- Objective scoring (PR7) ---
# The `exec` signal runs candidate build/tests/coverage inside the locked
# heg-exec container (--network none, candidate code demoted to nobody,
# resource + tmpfs caps).
# 0/false/off → the collector reports "skipped". Requires the repo-built
# image (never pulled): docker build -f sandbox/images/exec.Dockerfile -t heg-exec:latest .
# SCORING_EXEC=1
# EXEC_IMAGE=heg-exec:latest
# PR8: LLM-generated pytest suite run against the submission in the same
# locked heg-exec container (suite mounts read-only, coverage stays on the
# candidate code). 0/false/off → the signal reports "skipped"; generation
# traffic rides the eval cred's token budget.
# SCORING_TESTGEN=1
# Generation tuning (defaults shown; TESTGEN_MODEL falls back to the
# evaluator model when unset):
# TESTGEN_MODEL=qwen2.5-coder:3b
# TESTGEN_SOURCE_BUDGET_BYTES=24000
# TESTGEN_MAX_FILES=8
# TESTGEN_MAX_TOKENS=4096
# TESTGEN_TIMEOUT_SECONDS=240
# Single retry of the generation call (empty content / zero runnable files /
# timeout) at this raised max_tokens + 2x TESTGEN_TIMEOUT_SECONDS.
# TESTGEN_MAX_TOKENS_RETRY=8192
# Judge-output reliability: when the agentic judge leaves a missing/unusable
# scores.json, one bounded control-plane chat call on the eval cred asks the
# evaluator model for the scores document directly. 0/false/off disables.
# EVAL_DIRECT_FALLBACK=1
# EVAL_DIRECT_MAX_TOKENS=4096
# EVAL_DIRECT_TIMEOUT_SECONDS=240
# EVAL_DIRECT_SOURCE_BUDGET_BYTES=24000

LOG_LEVEL=INFO
